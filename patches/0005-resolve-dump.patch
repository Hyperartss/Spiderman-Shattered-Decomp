+#include <cstdio>
+#include <ctime>
 /**
  ******************************************************************************
  * Xenia : Xbox 360 Emulator Research Project                                 *
@@ -1145,6 +1147,61 @@ bool VulkanRenderTargetCache::Resolve(const memory::Memory& memory,
     return true;
   }
 
+  // SD360 diagnostic: log the resolve/copy geometry whenever it changes.
+  // A resolve that covers only part of the target, or copies with a wrong
+  // pitch, leaves a thin band of valid pixels in a texture the game samples as
+  // full-frame - the squashed-strip artifact.
+  {
+    static long sd360_res_count = 0;
+    uint32_t sd360_base = 0, sd360_row_len = 0, sd360_rows = 0, sd360_pitch = 0;
+    resolve_info.GetCopyEdramTileSpan(sd360_base, sd360_row_len, sd360_rows, sd360_pitch);
+    struct Sd360Res {
+      uint32_t depth, base, row_len, rows, pitch, w8, h8, dest, dstart, dlen, fmt;
+    };
+    Sd360Res sd360_now;
+    sd360_now.depth = resolve_info.IsCopyingDepth() ? 1u : 0u;
+    sd360_now.base = sd360_base;
+    sd360_now.row_len = sd360_row_len;
+    sd360_now.rows = sd360_rows;
+    sd360_now.pitch = sd360_pitch;
+    sd360_now.w8 = resolve_info.coordinate_info.width_div_8;
+    sd360_now.h8 = resolve_info.height_div_8;
+    sd360_now.dest = resolve_info.copy_dest_base;
+    sd360_now.dstart = resolve_info.copy_dest_extent_start;
+    sd360_now.dlen = resolve_info.copy_dest_extent_length;
+    sd360_now.fmt = resolve_info.copy_dest_info.value;
+    // Front-buffer resolves: logged every time, without deduplication. The
+    // scene only reaches the frame through a copy into the front buffer, so a
+    // frame whose copy is skipped or shortened shows the HUD (drawn directly
+    // into the framebuffer) over black or over a thin band. 0x04445000 is the
+    // front buffer reported by every swap so far (fb=71585792).
+    if (sd360_now.dest == 0x04445000u) {
+      std::fprintf(stderr, "SD360FB t=%ld depth=%u base=%u rows=%u pitch=%u w8=%u h8=%u dlen=%u fmt=%08X\n",
+                   (long)std::time(nullptr), sd360_now.depth, sd360_now.base,
+                   sd360_now.rows, sd360_now.pitch, sd360_now.w8, sd360_now.h8,
+                   sd360_now.dlen, sd360_now.fmt);
+      std::fflush(stderr);
+    }
+    static Sd360Res sd360_last = {};
+    if (sd360_now.depth != sd360_last.depth || sd360_now.base != sd360_last.base ||
+        sd360_now.row_len != sd360_last.row_len || sd360_now.rows != sd360_last.rows ||
+        sd360_now.pitch != sd360_last.pitch || sd360_now.w8 != sd360_last.w8 ||
+        sd360_now.h8 != sd360_last.h8 || sd360_now.dest != sd360_last.dest ||
+        sd360_now.dstart != sd360_last.dstart || sd360_now.dlen != sd360_last.dlen ||
+        sd360_now.fmt != sd360_last.fmt) {
+      sd360_last = sd360_now;
+      ++sd360_res_count;
+      std::fprintf(stderr,
+                   "SD360RES t=%ld n=%ld depth=%u base=%u rowlen=%u rows=%u pitch=%u "
+                   "w8=%u h8=%u dest=%08X dstart=%08X dlen=%u fmt=%08X\n",
+                   (long)std::time(nullptr), sd360_res_count, sd360_now.depth,
+                   sd360_now.base, sd360_now.row_len, sd360_now.rows, sd360_now.pitch,
+                   sd360_now.w8, sd360_now.h8, sd360_now.dest, sd360_now.dstart,
+                   sd360_now.dlen, sd360_now.fmt);
+      std::fflush(stderr);
+    }
+  }
+
   const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
   const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
   const VkDevice device = vulkan_device->device();
